# Local development defaults for SalomatOS v2. Copy to .env and adjust.
# Never put v1 production values (secret key, database, bot token) here.

# Generate a fresh key per environment:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-local-only
# Off unless set: production must never run with DEBUG on.
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
# Same-origin frontend needs nothing here. List origins only for a separate dev server.
CORS_ALLOWED_ORIGINS=

DB_NAME=salomatos_v2
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7
LOGIN_THROTTLE_RATE=10/min

# Private directory for X-rays and photos. Never expose it through nginx.
MEDIA_ROOT=./private_media
MAX_ATTACHMENT_MB=50

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Telegram bot (python manage.py run_bot). Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Encrypts bot passwords so staff can read them back. Set your own in production:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOT_CREDENTIAL_KEY=
